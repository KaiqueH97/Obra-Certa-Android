<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="25dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="25dp">

            <TextView
                android:id="@+id/tvNomeProjetoDetalhe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cliente Kaique"
                android:textColor="#1A202C"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVoltarDetalhes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voltar"
                android:textColor="@color/laranja_principal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_aba_inativa"
            android:padding="4dp"
            android:layout_marginBottom="25dp">

            <LinearLayout
                android:id="@+id/btnAbaOrcamento"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_aba_inativa">

                <TextView
                    android:id="@+id/tvTextoOrcamento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛒 Orçamento"
                    android:textColor="#64748B"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAbaTarefas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_aba_ativa">

                <TextView
                    android:id="@+id/tvTextoTarefas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 Tarefas"
                    android:textColor="@color/laranja_principal"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llAbaTarefas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <EditText
                    android:id="@+id/etNovaTarefa"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:hint="O que precisa ser feito?"
                    android:background="@drawable/bg_input_borda"
                    android:padding="15dp"
                    android:layout_marginEnd="10dp"/>

                <Button
                    android:id="@+id/btnAdicionarTarefa"
                    android:layout_width="80dp"
                    android:layout_height="55dp"
                    android:text="Add"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="#1A202C"
                    app:cornerRadius="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llListaTarefas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llAbaOrcamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_verde_escuro"
                android:padding="20dp"
                android:gravity="center"
                android:layout_marginBottom="25dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CUSTO TOTAL ACUMULADO"
                    android:textColor="#A7F3D0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"/>

                <TextView
                    android:id="@+id/tvCustoTotalProjeto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ 0,00"
                    android:textColor="@color/white"
                    android:textSize="40sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llListaMateriais"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnNovoCalculo"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="+ Novo Cálculo de Material"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#D97706"
                app:cornerRadius="8dp"
                android:layout_marginBottom="15dp"
                android:layout_marginTop="5dp"/>

            <Button
                android:id="@+id/btnPedirCotacao"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Pedir Cotação no WhatsApp"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#22C55E"
                app:cornerRadius="8dp" />

        </LinearLayout>


    </LinearLayout>
</ScrollView>