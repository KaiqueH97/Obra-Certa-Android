<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="15dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvNomeClienteItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cliente Gabriel"
                android:textColor="#1A202C"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAbrirObra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Abrir Obra"
                android:textColor="#C2410C"
                android:textStyle="bold"
                android:background="#FFEDD5"
                android:paddingHorizontal="15dp"
                android:paddingVertical="8dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <TextView
                android:id="@+id/btnEditarProjeto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar"
                android:textColor="#2563EB"
                android:textStyle="bold"
                android:layout_marginEnd="20dp"
                android:padding="5dp"/>

            <TextView
                android:id="@+id/btnExcluirProjeto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Excluir"
                android:textColor="#DC2626"
                android:textStyle="bold"
                android:padding="5dp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>